{
  "datasets": [
    {
      "name": "56c17320",
      "displayName": "location_data",
      "queryLines": [
        "select latitude,longitude,`GHG emissions mtons CO2e` as Emissions from emissions_data;"
      ]
    },
    {
      "name": "ee227c3d",
      "displayName": "County Level Greenhouse Gas Emissions Analysis Dataset",
      "queryLines": [
        "select\r\n",
        "  county_state_name,\r\n",
        "  `GHG emissions mtons CO2e` as total_emissions,\r\n",
        "  population,\r\n",
        "  cast(cast(replace(`GHG emissions mtons CO2e`, ',', '') as double) / population as int) as emissions_per_person\r\n",
        "from emissions_data;\r\n"
      ]
    },
    {
      "name": "94aa7b9b",
      "displayName": "Statewise Greenhouse Gas Emissions Summary",
      "queryLines": [
        "select\r\n",
        "  state_abbr,\r\n",
        "  sum(cast(replace(`GHG emissions mtons CO2e`, ',', '') as double)) as total_emissions\r\n",
        "from emissions_data\r\n",
        "group by state_abbr\r\n",
        "order by total_emissions desc\n",
        "limit 10;"
      ]
    },
    {
      "name": "5abf14fd",
      "displayName": "Top Ten Counties by Greenhouse Gas Emissions and Population",
      "queryLines": [
        "select\r\n",
        "  county_name,\r\n",
        "  cast(regexp_replace(`GHG emissions mtons CO2e`, ',', '') as double) as total_emissions,\r\n",
        "  population\r\n",
        "from emissions_data\r\n",
        "order by total_emissions desc\r\n",
        "limit 10;\r\n"
      ]
    }
  ],
